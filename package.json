{
  "name": "@deepwhale-cn/dsh-qq-bridge",
  "version": "0.3.1",
  "description": "深鲸 QQ 桥接：把 QQ 接进 DSH —— QQ 官方机器人 WebSocket（AppID/AppSecret）或 OneBot v11 二选一；侧栏收发、入站入队、全量审计；v0.3 自动回复（关键词规则 + 模板 + 防刷，默认关）",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "qq-bot",
    "qq-official-bot",
    "qq-open-platform",
    "onebot",
    "onebot-v11",
    "websocket",
    "bridge",
    "im",
    "客服",
    "企业通知",
    "auto-reply",
    "关键词回复",
    "qq-official"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "preflight": "node scripts/preflight-client.mjs .",
    "prepublishOnly": "node scripts/preflight-client.mjs ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-qq-bridge.git"
  },
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>",
  "homepage": "https://deepwhale.org.cn/plugins.html"
}
